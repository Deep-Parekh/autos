# Trusted runner supervisor settings for the server. Install as /etc/autos/supervisor.env (0600, root-owned);
# loaded by systemd (EnvironmentFile=) in deploy/systemd/autos-supervisor.service. Plain KEY=value lines only.
AUTOS_WORKER_IMAGE=autos-worker-providers:local
AUTOS_CHECKS_IMAGE=autos-checks:local
# Provider logins: 0600 and owned by the autos user, outside /opt/autos. Template: config/provider-profiles.example.json
# (team subscriptions) or config/provider-profiles.api.example.json (API keys / local model). The Codex login
# directory named in the profile (e.g. codex-pilot/auth.json) lives next to this file.
AUTOS_PROVIDER_PROFILES_FILE=/etc/autos/auth/provider-profiles.json
# Agent containers need egress to provider APIs. Create once: docker network create autos-egress
# Refuse to start unless every profile is mode "subscription" (never fall back to API pricing).
AUTOS_REQUIRE_SUBSCRIPTION=true
# Per-run private copies of the Codex login. Must be a host path Docker can bind-mount (the service has a private /tmp)
# and listed in ReadWritePaths of autos-supervisor.service.
AUTOS_AUTH_STAGING_ROOT=/opt/autos/auth-staging
AUTOS_PROVIDER_NETWORK=autos-egress
AUTOS_PROVIDER_NETWORK_APPROVED=true
# Offline Maven repository for checks (the repository directory itself), outside /opt/autos and /etc/autos/auth.
AUTOS_MAVEN_CACHE_ROOT=/var/lib/autos/m2-repository
# The controller runs in Compose and sees /opt/autos as /app.
AUTOS_CLIENT_ROOT=/app
# Run agent/check containers as the autos user (must match AUTOS_CONTROLLER_UID/GID).
AUTOS_RUNNER_UID=
AUTOS_RUNNER_GID=
