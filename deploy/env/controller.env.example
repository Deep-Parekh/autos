# Controller secrets for the server. Install as /opt/autos/.env (0600, owned by the autos user); Compose reads it.
# Provider API keys do NOT belong here: they live only in the supervisor's provider profile file.

# Atlassian Cloud account that can read the private saved filter and the branch-map page.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
AUTOS_ATLASSIAN_EMAIL=
AUTOS_ATLASSIAN_TOKEN=
# Bearer token for the loopback API and `autos status/watch`. Generate: openssl rand -hex 24
AUTOS_OPERATOR_TOKEN=
# Optional: Bitbucket read token for similar-fix lookup (also set bitbucket.read_token_env in config.yaml).
# AUTOS_BITBUCKET_READ_TOKEN=
# Compose: run the controller as the same uid/gid that owns /opt/autos/{data,artifacts,workspaces} and the socket.
AUTOS_CONTROLLER_UID=
AUTOS_CONTROLLER_GID=
# Directory holding askpass.sh + bitbucket-token (mounted read-only at /run/autos-git).
AUTOS_GIT_SECRETS_DIR=/etc/autos/git
