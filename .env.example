# Local pilot environment. Copy to .env (git-ignored), fill in, then: set -a; source .env; set +a
# Never put these values in config/config.yaml.

# --- Controller (read by autos CLI / controller) ---
# Atlassian Cloud account that can read the private saved filter and the branch-map page.
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
AUTOS_ATLASSIAN_EMAIL=
AUTOS_ATLASSIAN_TOKEN=
# Bearer token for the local HTTP API (16+ chars). Generate: openssl rand -hex 24
AUTOS_OPERATOR_TOKEN=
# Optional: Teams Workflows webhook for `autos teams relay` (secret; the URL carries a signature).
AUTOS_TEAMS_WEBHOOK_URL=
# Optional: Bitbucket read-only token for precedent lookup (also set bitbucket.read_token_env).
# AUTOS_BITBUCKET_READ_TOKEN=
# Git fetch/push credentials stay with trusted code: either rely on your ssh-agent (SSH_AUTH_SOCK, git@ remote)
# or point at an askpass helper for an https remote.
# AUTOS_GIT_ASKPASS_PATH=/absolute/path/to/askpass.sh

# --- Supervisor (read by scripts/pilot-supervisor.sh) ---
AUTOS_WORKER_IMAGE=autos-worker-providers:local
AUTOS_CHECKS_IMAGE=autos-checks:local
# Private profile file OUTSIDE the repo, chmod 600 (template: config/provider-profiles.example.json)
AUTOS_PROVIDER_PROFILES_FILE=${HOME}/.autos/auth/provider-profiles.json
# Refuse any profile that is not mode "subscription" (team plans only, never API pricing).
AUTOS_REQUIRE_SUBSCRIPTION=true
# Per-run private copies of the Codex login (created 0700 on first use; Docker Desktop must be able to mount it).
AUTOS_AUTH_STAGING_ROOT=${HOME}/.autos/auth-staging
# Real providers need egress to their APIs. Create once: docker network create autos-egress
AUTOS_PROVIDER_NETWORK=autos-egress
AUTOS_PROVIDER_NETWORK_APPROVED=true
# Offline Maven repository (the repository dir itself), OUTSIDE the repo and outside the auth folder (docs/local-pilot.md step 5)
AUTOS_MAVEN_CACHE_ROOT=${HOME}/.autos/m2-repository
# Per-project JDK/Tomcat toolchains (scripts/install-toolchains.ts); mounted read-only into agent and check containers.
AUTOS_TOOLCHAIN_ROOT=${HOME}/.autos/toolchains
